# Local development settings; never put real credentials in this file.
NODE_ENV=development
PORT=4000
# Where the gate keeps its append-only audit log. Optional; the default is
# data/audit.jsonl under apps/api/, which is gitignored.
AUDIT_LOG_PATH=

# PayPal Sandbox. The API host is fixed in code to https://api-m.sandbox.paypal.com;
# do not set PAYPAL_BASE_URL (if you do, it must be exactly that URL).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The payment-token id from vault step 01b.2 (the "vault_id").
# It is NOT the setup-token id from step 01a.1. Using the setup-token id gave
# the 404 RESOURCE_NOT_FOUND seen in E-1.
PAYPAL_VAULT_ID=

# Select one provider and use its documented configuration.
# The exact variable name should match the chosen AI SDK.
# Example only:
# ANTHROPIC_API_KEY=

# Add only if the approved implementation uses a database.
# DATABASE_URL=