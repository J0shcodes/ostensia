# Where the Next.js server forwards /api requests: the Ostensia API (D-027).
# Server-side only. Never expose this through a NEXT_PUBLIC_ variable.
# It must be exactly http://127.0.0.1:<port> (no other host, path or credentials).
# `next build` reads it at build time, so set it before building; `next dev` reads it
# at startup. If unset, http://127.0.0.1:4000 is used.
API_ORIGIN=http://127.0.0.1:4000
